{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "small_model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "enabled_providers": ["openrouter"],
  "provider": {
    "openrouter": {
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {}
      }
    }
  },
  "permission": {
    "*": "deny",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "allow",
      "rm -rf .git*": "deny",
      "rm -rf .github*": "deny",
      "rm -rf *": "deny",
      "git init*": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push *--force*": "deny",
      "git push * -f*": "deny"
    }
  }
}
